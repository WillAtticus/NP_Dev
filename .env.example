# NeuroPulse Environment Configuration (Local-first)

# Application Mode
APP_ENV=development
LOG_LEVEL=INFO

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
SECRET_KEY=change-this-local-secret-key-neuro-pulse-2026

# Database & Storage
DATABASE_URL=sqlite:///./neuropulse.db
DATA_DIR=./data
SESSIONS_DIR=./data/sessions
EXPORTS_DIR=./exports

# Acquisition & Serial Configuration
DEFAULT_SERIAL_PORT=
DEFAULT_BAUD_RATE=115200
ACQUISITION_BUFFER_MAX_PACKETS=10000
RAW_STORAGE_FORMAT=hdf5

# Simulation
ENABLE_SIMULATOR=true
